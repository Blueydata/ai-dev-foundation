{
  "permissions": {
    "allow": [
      "Bash(docker compose exec -T app npm test)",
      "Bash(docker compose exec -T app npm run test)",
      "Bash(docker compose exec -T app npm run typecheck)",
      "Bash(docker compose exec -T app npm run test:integration)",
      "Bash(docker compose exec -T app npm run build)",
      "Bash(docker compose exec -T app npm run check:secrets)",
      "Bash(docker compose exec -T app npm run db:migrate)",
      "Bash(docker compose exec -T app npm run check:env)",
      "Bash(docker compose exec -T app npm run db:explain *)",
      "Bash(docker compose exec -T app npm run db:query *)",
      "Bash(docker compose version)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(curl -s http://localhost:3000/api/health)",
      "mcp__playwright",
      "Bash(git --version)",
      "Bash(docker --version)",
      "Bash(docker info *)",
      "Bash(docker compose up -d --wait)",
      "Bash(docker compose up -d)",
      "Bash(test -f docker-compose.yml)",
      "Bash(uname -s)",
      "Bash(npm test)",
      "Bash(npm run test)",
      "Bash(npm run typecheck)",
      "Bash(npm run test:integration)",
      "Bash(npm run build)",
      "Bash(npm run check:secrets)",
      "Bash(npm run db:migrate)",
      "Bash(npm run check:env)",
      "Bash(npm run db:explain *)",
      "Bash(npm run db:query *)",
      "Bash(scripts/cloud-setup.sh)",
      "Bash(tail -n 40 /tmp/dev-foundation-app.log)"
    ],
    "deny": [
      "Read(**/.env)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "playwright"
  ]
}
