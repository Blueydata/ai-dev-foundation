resource "aws_secretsmanager_secret" "provided" {
  for_each = toset(var.provided_secret_names)

  name                    = "${var.project}/${var.environment}/${each.key}"
  description             = "Value provided by the product owner"
  recovery_window_in_days = var.recovery_window_in_days
}

resource "random_password" "generated" {
  for_each = toset(var.generated_secret_names)

  length  = 48
  special = false
}

resource "aws_secretsmanager_secret" "generated" {
  for_each = toset(var.generated_secret_names)

  name                    = "${var.project}/${var.environment}/${each.key}"
  description             = "Value generated by Terraform"
  recovery_window_in_days = var.recovery_window_in_days
}

resource "aws_secretsmanager_secret_version" "generated" {
  for_each = toset(var.generated_secret_names)

  secret_id     = aws_secretsmanager_secret.generated[each.key].id
  secret_string = random_password.generated[each.key].result
}
